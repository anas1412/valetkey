#!/usr/bin/env bash
# valetkeyctl: a small helper for the Valetkey admin API.
# It opens a kubectl port-forward to the Valetkey pod by itself, so your kubeconfig's
# Kubernetes permissions are all it needs. Needs bash, curl, jq and kubectl.
set -euo pipefail

NAMESPACE="${VALETKEY_NAMESPACE:-valetkey-system}"
TARGET="${VALETKEY_TARGET:-deploy/valetkey}"
SERVER="${VALETKEY_SERVER:-}"   # set to skip the port-forward, e.g. http://localhost:8082

die() { echo "ERROR: $*" >&2; exit 1; }

usage() {
  cat <<'EOF'
Usage: valetkeyctl <command> [args]

Status:
  status                  Summary of providers, tenants and keys
  status channels         Providers: name, type, models
  status groups           Tenants: name, status, providers
  status keys             API keys: namespace, name, ready

Providers and tenants:
  channel <name>          Show a provider (JSON)
  group <name>            Show a tenant (JSON)
  models <tenant>         Models a tenant's keys can use
  test channel <name>     Check that the provider accepts its API key

Costs:
  spend                   Spend and budget of every tenant and key, this period
  pricing                 Price of each provider model right now, per 1M tokens

API keys:
  key <namespace>/<name>      Print the virtual key (audited)
  rotate <namespace>/<name>   Issue a new key; the old one stops working (audited)

Dashboard:
  dashboard [port]        Port-forward the dashboard to http://localhost:<port> (default 8082)

Environment:
  VALETKEY_NAMESPACE  namespace Valetkey runs in (default valetkey-system)
  VALETKEY_TARGET     what to port-forward to (default deploy/valetkey)
  VALETKEY_SERVER     use this admin URL instead of starting a port-forward
EOF
  exit 0
}

# Starts a port-forward on a free local port and sets SERVER; stopped on exit.
connect() {
  [ -n "$SERVER" ] && return
  command -v kubectl >/dev/null || die "kubectl not found"
  PF_LOG=$(mktemp)
  kubectl port-forward -n "$NAMESPACE" "$TARGET" :8082 >"$PF_LOG" 2>&1 &
  PF_PID=$!
  trap 'kill "$PF_PID" 2>/dev/null; rm -f "$PF_LOG"' EXIT
  local port
  for _ in $(seq 1 100); do
    port=$(sed -n 's/^Forwarding from 127\.0\.0\.1:\([0-9]*\).*/\1/p' "$PF_LOG" | head -1)
    if [ -n "$port" ]; then SERVER="http://localhost:$port"; return; fi
    kill -0 "$PF_PID" 2>/dev/null || die "port-forward failed: $(cat "$PF_LOG")"
    sleep 0.1
  done
  die "port-forward did not start: $(cat "$PF_LOG")"
}

# Calls the admin API: api <path> [curl args]. The X-Valetkey-Request header is required
# by the API (it blocks cross-site requests from browsers).
api() {
  local path=$1; shift
  connect
  curl -sS --fail-with-body -H "X-Valetkey-Request: 1" "$@" "$SERVER/api/v1$path"
}

# Sets ns and name from "namespace/name", or dies with the usage hint for command $2.
split_key() { [[ "${1:-}" == */?* ]] || die "usage: valetkeyctl $2 <namespace>/<name>"; ns=${1%%/*}; name=${1#*/}; }

table() { column -t -s$'\t'; }

cmd="${1:-}"
shift 2>/dev/null || true

case "$cmd" in
  status)
    data=$(api /status)
    case "${1:-}" in
      channels)
        { echo -e "NAME\tTYPE\tMODELS"; jq -r '.channels[] | [.name, .type, (if (.models | length) > 0 then (.models | join(",")) else "any" end)] | @tsv' <<<"$data"; } | table ;;
      groups)
        { echo -e "NAME\tSTATUS\tCHANNELS"; jq -r '.groups[] | [.name, .status, (.channels | join(","))] | @tsv' <<<"$data"; } | table ;;
      keys)
        { echo -e "NAMESPACE\tNAME\tREADY"; jq -r '.keys[] | [.namespace, .name, (if .ready then "yes" else "no" end)] | @tsv' <<<"$data"; } | table ;;
      *)
        printf "channels: %d  groups: %d  keys: %d\n\n" \
          "$(jq '.channels | length' <<<"$data")" "$(jq '.groups | length' <<<"$data")" "$(jq '.keys | length' <<<"$data")"
        { echo -e "CHANNEL\tTYPE\tREADY"; jq -r '.channels[] | [.name, .type, (if .ready then "yes" else "no" end)] | @tsv' <<<"$data"; } | table
        echo
        { echo -e "GROUP\tSTATUS\tCHANNELS"; jq -r '.groups[] | [.name, .status, (.channels | join(","))] | @tsv' <<<"$data"; } | table
        echo
        { echo -e "KEY\tREADY"; jq -r '.keys[] | [.namespace + "/" + .name, (if .ready then "yes" else "no" end)] | @tsv' <<<"$data"; } | table ;;
    esac ;;
  test)
    [ "${1:-}" = "channel" ] && [ -n "${2:-}" ] || die "usage: valetkeyctl test channel <name>"
    api "/channels/$2/test" -X POST | jq . ;;
  channel)
    [ -n "${1:-}" ] || die "usage: valetkeyctl channel <name>"
    api "/channels/$1" | jq . ;;
  group)
    [ -n "${1:-}" ] || die "usage: valetkeyctl group <name>"
    api "/groups/$1" | jq . ;;
  models)
    [ -n "${1:-}" ] || die "usage: valetkeyctl models <tenant>"
    api "/groups/$1/models" | jq -r '.models[]?' ;;
  spend)
    money='def usd: if . == null then "-" else (. * 100 | round) as $c | "$\($c / 100 | floor).\($c % 100 | tostring | if length < 2 then "0" + . else . end)" end;
      def row(n): [n, (.spend.exact | "$" + .), (.spend.budget | usd), (.spend.period // "-"), ((.spend.resets // "-") | sub("T.*"; ""))];'
    { echo -e "TENANT\tSPENT\tBUDGET\tPERIOD\tRESETS"; api /groups | jq -r "$money"' .[] | row(.name) | @tsv'; } | table
    echo
    { echo -e "KEY\tSPENT\tBUDGET\tPERIOD\tRESETS"; api /proxykeys | jq -r "$money"' .[] | row(.namespace + "/" + .name) | @tsv'; } | table ;;
  pricing)
    data=$(api /pricing)
    { echo -e "PROVIDER\tMODEL\tINPUT\tOUTPUT\tCACHE READ\tNOW\tSOURCE"
      jq -r 'def p: "$" + (. * 1000 | round / 1000 | tostring);
        .prices[] | [.channel, .model,
          (if .known then (.input | p) else "-" end), (if .known then (.output | p) else "-" end),
          (if .known then (.cacheRead | p) else "-" end), (.period // "flat"),
          (if .known then .source else "no price, set spec.pricing" end)] | @tsv' <<<"$data"; } | table
    echo
    jq -r '"Prices fetched " + (.fetchedAt // "never") + ", refresh every " + .refresh' <<<"$data"
    jq -r '.sources[] | select(.ok | not) | "WARNING: " + .name + " failed: " + .error' <<<"$data" ;;
  key)
    split_key "${1:-}" key
    api "/proxykeys/$ns/$name/key" | jq -r .key ;;
  rotate)
    split_key "${1:-}" rotate
    api "/proxykeys/$ns/$name/rotate" -X POST >/dev/null
    echo "rotated $ns/$name; the old key no longer works" ;;
  dashboard)
    port="${1:-8082}"
    echo "Dashboard: http://localhost:$port  (Ctrl+C to stop)"
    exec kubectl port-forward -n "$NAMESPACE" "$TARGET" "$port:8082" ;;
  *)
    usage ;;
esac

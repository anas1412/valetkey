#!/usr/bin/env bash
set -euo pipefail

API_SERVER="${LLMPROXY_SERVER:-http://localhost:8081}"
ADMIN_KEY="${LLMPROXY_ADMIN_KEY:-${ADMIN_KEY:-}}"

die()  { echo "ERROR: $*" >&2; exit 1; }
[ -n "$ADMIN_KEY" ] || die "set LLMPROXY_ADMIN_KEY (or ADMIN_KEY) to the admin key"
H() { curl -sS --fail-with-body -H "Authorization: Bearer $ADMIN_KEY" "$@"; }

usage() {
  cat <<'EOF'
Usage: llmproxyctl <command> [args]

Commands:
  status              Overall summary (channels, groups, keys)
  status channels     List channels: name, type, models
  status groups       List groups: name, status, channels
  status keys         List proxy keys: namespace, name, ready

  test channel <name> Check that the provider accepts the channel's API key

  channel <name>      Show channel details
  group <name>        Show group details

Env vars: LLMPROXY_SERVER     admin endpoint (default http://localhost:8081)
          LLMPROXY_ADMIN_KEY  admin key (falls back to ADMIN_KEY)
EOF
  exit 0
}

cmd="${1:-}"
shift 2>/dev/null || true

case "$cmd" in
  status)
    sub="${1:-}"
    data=$(H "$API_SERVER/api/v1/status") || die "no response from $API_SERVER"
    case "$sub" in
      channels)
        { echo -e "NAME\tTYPE\tMODELS"; echo "$data" | jq -r '.channels[] | [.name, .type, (.models | join(","))] | @tsv'; } | column -t -s$'\t' ;;
      groups)
        { echo -e "NAME\tSTATUS\tCHANNELS"; echo "$data" | jq -r '.groups[] | [.name, .status, (.channels | join(","))] | @tsv'; } | column -t -s$'\t' ;;
      keys)
        { echo -e "NAMESPACE\tNAME\tREADY"; echo "$data" | jq -r '.keys[] | [.namespace, .name, (if .ready then "yes" else "no" end)] | @tsv'; } | column -t -s$'\t' ;;
      *)
        printf "channels: %d  groups: %d  keys: %d\n\n" \
          "$(echo "$data" | jq '.channels | length')" "$(echo "$data" | jq '.groups | length')" "$(echo "$data" | jq '.keys | length')"
        { echo -e "CHANNEL\tTYPE\tREADY"; echo "$data" | jq -r '.channels[] | [.name, .type, (if .ready then "yes" else "no" end)] | @tsv'; } | column -t -s$'\t'
        echo
        { echo -e "GROUP\tSTATUS\tCHANNELS"; echo "$data" | jq -r '.groups[] | [.name, .status, (.channels | join(","))] | @tsv'; } | column -t -s$'\t'
        echo
        { echo -e "KEY\tREADY"; echo "$data" | jq -r '.keys[] | [.namespace + "/" + .name, (if .ready then "yes" else "no" end)] | @tsv'; } | column -t -s$'\t' ;;
    esac ;;
  test)
    [ "${1:-}" = "channel" ] && [ -n "${2:-}" ] || die "usage: llmproxyctl test channel <name>"
    H -X POST "$API_SERVER/api/v1/channels/$2/test" | jq . ;;
  channel)
    [ -n "${1:-}" ] || die "usage: llmproxyctl channel <name>"
    H "$API_SERVER/api/v1/channels/$1" | jq . ;;
  group)
    [ -n "${1:-}" ] || die "usage: llmproxyctl group <name>"
    H "$API_SERVER/api/v1/groups/$1" | jq . ;;
  *)
    usage ;;
esac

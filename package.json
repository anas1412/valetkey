{
  "name": "llmproxy-k8s",
  "version": "2.0.0",
  "description": "Kubernetes-native LLM proxy: virtual API keys for OpenAI/Anthropic, managed with CRDs",
  "main": "dist/main.js",
  "bin": {
    "llmproxyctl": "./scripts/llmproxyctl"
  },
  "type": "module",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p .",
    "start": "node dist/main.js",
    "test": "tsc -p tsconfig.test.json && node --test \"build-test/**/*.test.js\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@kubernetes/client-node": "^2.0.1",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "express": "^5.3.0",
    "prom-client": "^15.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.5"
  }
}
